# Input files as generated by `mojo doc` plus hand-authored guides.
input:
  - docs/src

# Mojo source packages monitored in watch mode.
source:
  - @MOJO_PACKAGE@

@MODO_SOURCE_URL@

output: docs/site/content
tests: docs/test
format: hugo
exports: true
short-links: true
report-missing: true
strict: true
dry-run: false
case-insensitive: false
templates: [docs/templates]

pre-run:
  - |
    echo "Running 'mojo doc'..."
    pixi run mojo doc --diagnose-missing-doc-strings --Werror -o docs/src/@MOJO_PACKAGE@.json @MOJO_PACKAGE@
    echo "Done."

pre-build: []
pre-test: []
post-test:
  - |
    echo "Running generated documentation examples..."
    pixi run python3 ci/run_mojo_tests.py --directory docs/test --pattern '*.mojo'
    echo "Done."
post-build: []
post-run: []
